# Frontend configuration. Copy to .env.local (git-ignored) and adjust.
#
# IMPORTANT: every variable starting with VITE_ is bundled into the browser code
# and is PUBLIC. Never put a secret, a token or a database URL in a VITE_ variable.
# The browser never talks to the database: only to the backend's REST API.

# Where the browser sends API requests.
# Leave EMPTY (recommended) to use the same origin as the dashboard: in production
# the same hostname routes /api/* to the backend; locally the Vite dev server
# proxies /api to the backend. Set a full URL only if the API is on another origin
# (then the backend needs ADMIN_ALLOWED_ORIGINS and Cloudflare Access cookies must
# be valid for that origin).
VITE_API_BASE_URL= postgresql://neondb_owner:npg_ZxUn5qvfS6XL@ep-blue-firefly-za2qgnnj-pooler.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional: Cloudflare Access sign-out URL shown on the Settings page,
# e.g. https://<team>.cloudflareaccess.com/cdn-cgi/access/logout
VITE_ACCESS_LOGOUT_URL= https://epi-dashboard-bay.vercel.app

# ---- Development server only (NOT bundled: read by vite.config.js in Node) ----

# Backend the dev server proxies /api to.
DEV_API_TARGET=http://localhost:3000

# Development token sent to the backend by the dev proxy (what Cloudflare Access
# does in production). Create one in the backend with:
#   npm run dev:token -- you@example.com
# and run the backend with AUTH_MODE=dev.
DEV_ACCESS_TOKEN=
