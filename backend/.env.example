# Copy this file to .env and adjust values as needed.
# .env is git-ignored and must never be committed.

# Runtime environment: development | production | test
NODE_ENV=development

# Port the HTTP server listens on (local development only; Vercel manages its own)
PORT=3000

# Set to "false" to disable per-request logging
REQUEST_LOGGING=true

# Maximum JSON request body size (b, kb or mb). Forms are small; keep this low.
BODY_LIMIT=100kb

# PostgreSQL connection string (Neon). Real value goes in .env only, never commit it.
# Use sslmode=verify-full (full certificate verification).
DATABASE_URL=

# Max connections per server instance. Keep small on serverless + Neon pooler.
DB_POOL_MAX=5

# Dedicated TEST database (e.g. central_backend_test in the same Neon project). Tests NEVER use DATABASE_URL.
TEST_DATABASE_URL=

# --- Step 4: rate limiting & transport security -------------------------

# Where the real client IP comes from:
#   socket            local development only (TCP peer; all forwarding headers ignored)
#   cloudflare-worker app runs on Cloudflare Workers (trusts CF-Connecting-IP)
#   cloudflare-proxy  Node origin behind Cloudflare's proxy (trusts CF-Connecting-IP
#                     only from Cloudflare's published edge IP ranges)
#   vercel-cloudflare Vercel origin behind Cloudflare's proxy: CF-Connecting-IP is trusted
#                     only when Vercel reports (X-Vercel-Forwarded-For) that the connecting
#                     peer is a Cloudflare edge IP, and ORIGIN_AUTH_SECRET matches.
# Production must use a cloudflare-* or vercel-cloudflare value.
CLIENT_IP_SOURCE=socket

# vercel-cloudflare only (REQUIRED in production with that source): a random secret of
# 32+ characters. Add a Cloudflare Transform Rule (Modify Request Header, set static)
# that sets the header  X-Origin-Auth  to this same value on this hostname. Requests that
# reach Vercel without it (e.g. direct to *.vercel.app) are rejected with 403.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORIGIN_AUTH_SECRET=

# Rate-limit counter store: postgres (required in production) or memory (dev/tests).
# Defaults to postgres when DATABASE_URL is set.
RATE_LIMIT_STORE=

# Secret (32+ chars) for HMAC-hashing client IPs in rate-limit counters.
# Required in production. Generate with:  openssl rand -hex 32
RATE_LIMIT_SECRET=

# --- Step 5: admin authentication and CORS -------------------------------

# Admin API authentication:
#   cloudflare-access  verify Cloudflare Access JWTs (REQUIRED in production)
#   dev                locally signed tokens, see `npm run dev:token` (never production)
#   none               admin API answers 503
# Defaults to cloudflare-access when ACCESS_TEAM_DOMAIN is set, otherwise none.
AUTH_MODE=
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Origins allowed to call the ADMIN API from a browser (the dashboard).
# Comma-separated scheme://host[:port]. Production: https only.
ADMIN_ALLOWED_ORIGINS=

# Origins of EACH website, allowed to submit to ITS OWN forms only.
CORS_ORIGINS_EPINEON=
CORS_ORIGINS_QAEGIS=
CORS_ORIGINS_EPIWELL=
