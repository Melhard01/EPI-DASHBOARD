{
  "name": "central-backend",
  "version": "0.1.0",
  "description": "Centralized multi-application backend serving Epineon, QAegis and Epi Well.",
  "type": "module",
  "main": "src/app.js",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "NODE_ENV=test node --test tests/*.test.js",
    "db:migrate": "node scripts/migrate.js",
    "test:db": "NODE_ENV=test node --env-file-if-exists=.env --test --test-concurrency=1 tests/*.test.js",
    "dev:token": "node scripts/dev-token.js",
    "admin:create": "node scripts/create-super-admin.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
